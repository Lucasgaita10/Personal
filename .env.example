# ──────────────────────────────────────────────────────────────────
# Stone Gate — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ──────────────────────────────────────────────────────────────────

# Application
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
AI_SERVICE_URL=http://localhost:8000
DOC_SERVICE_URL=http://localhost:8001

# Postgres (with pgvector)
POSTGRES_USER=stonegate
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=stonegate
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://stonegate:change_me_local_only@localhost:5432/stonegate?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8002

# Auth
# 32-byte hex secret for JWT signing
JWT_SECRET=please_replace_with_64_hex_chars
JWT_EXPIRES_IN=12h

# Encryption — 32-byte hex (64 chars). Used to AES-GCM encrypt API keys & blobs.
MASTER_ENCRYPTION_KEY=please_replace_with_64_hex_chars

# AI providers — primary
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
ANTHROPIC_REASONING_MODEL=claude-opus-4-7
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001

# Optional: Voyage embeddings
VOYAGE_API_KEY=
EMBEDDING_PROVIDER=voyage          # voyage | local
EMBEDDING_MODEL=voyage-3-large

# Storage
BLOB_STORAGE_DIR=./data/blobs

# Feature flags
ENABLE_PROMPT_CACHING=true
ENABLE_HYBRID_RETRIEVAL=true
